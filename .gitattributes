# Normalize all text to LF in the repo and in working trees (fixes CRLF/LF drift that made the
# verified-citations staleness check differ between Windows checkouts and fresh clones).
* text=auto eol=lf

# Binary files: never touched by line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.exe binary
*.docx binary
*.xlsx binary
*.mp4 binary
*.mov binary
